[Unit]
Description=Stream GPS standalone device agent
After=network-online.target ModemManager.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/stream-gps-device/stream_gps_agent.py run
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/stream-gps-device /var/lib/stream-gps-device

[Install]
WantedBy=multi-user.target
