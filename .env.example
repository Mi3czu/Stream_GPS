# Used by Docker Compose. Never commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
APP_DOMAIN=gps.example.com
POSTGRES_POOL_MAX=10
# Optional chat integrations. Leave unset to keep Kick/Twitch completely disabled.
# PUBLIC_BASE_URL=https://gps.example.com
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# Optional SMTP for password reset emails. Without SMTP, reset links are logged
# only in non-production development mode and never returned through the API.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Stream GPS <no-reply@example.com>
